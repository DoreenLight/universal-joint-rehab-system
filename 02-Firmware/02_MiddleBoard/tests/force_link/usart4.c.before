int _ttywrch(int ch)
{
    ch = ch;
    return ch;
}

void _sys_exit(int x)
{
    x = x;
}

char *_sys_command_string(char *cmd, int len)
{
    return NULL;
}

FILE __stdout;

int fputc(int ch, FILE *f)
{
    while ((UART4->ISR & USART_ISR_TC) == 0U)
    {
    }
    UART4->TDR = (uint8_t)ch;
    return ch;
}
