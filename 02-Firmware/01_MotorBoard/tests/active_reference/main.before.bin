float   g_m2_traj_deg  = 0.0f;  /* Motor2 planned position (deg) */
float   g_m2_traj_vel  = 0.0f;  /* Motor2 planned velocity (deg/cycle) */

/* --- Rehab passive control state machine --- */
typedef enum {
    REHAB_IDLE = 0,
    REHAB_FORWARD,     /* moving toward max */
    REHAB_BACKWARD,    /* moving toward min */
    REHAB_RETURN       /* returning to zero */
} rehab_state_t;

typedef struct {
    uint8_t  active;       /* 0=stopped, 1=running */
    uint8_t  state;        /* rehab_state_t */
    float    target;       /* current target angle (°) */
    uint16_t half_cycles;  /* half-cycles completed */
} rehab_ctx_t;

static rehab_ctx_t g_rehab_m1 = {0u, REHAB_IDLE, 0.0f, 0u};
static rehab_ctx_t g_rehab_m2 = {0u, REHAB_IDLE, 0.0f, 0u};

/* --- Active rehab T-wave state machine (M1) --- */
typedef enum {
    ACTV_PAUSE_1 = 0,     /* paused at limit1 */
    ACTV_MOVING_TO_2,     /* moving toward limit2 */
    ACTV_PAUSE_2,         /* paused at limit2 */
    ACTV_MOVING_TO_1      /* moving toward limit1 */
} actv_state_t;

typedef struct {
    uint8_t     active;         /* 0=stopped, 1=running */
    uint8_t     state;          /* actv_state_t */
    float       pos;            /* virtual trajectory position (°) */
    float       vel;            /* current ramp velocity (deg/cycle) */
    uint16_t    pause_ticks;    /* pause countdown (100Hz ticks) */
} actv_rehab_t;

static actv_rehab_t g_actv_m1 = {0u, ACTV_PAUSE_1, 0.0f, 0.0f, 0u};
static float        g_actv_traj_pos = 0.0f;   /* M1 T-wave position for telemetry */

static actv_rehab_t g_actv_m2 = {0u, ACTV_PAUSE_1, 0.0f, 0.0f, 0u};
static float        g_actv_traj_pos_m2 = 0.0f; /* M2 T-wave position for telemetry */
static uint8_t      g_actv_m2_mode = 1u;       /* 1=flex/ext(Fy), 2=ulnar/radial(Fz) */

