void AD_Caiyang_process(void);
void Order_Creat_process(void);
void Signal_UPdata_Process(void)
{
	static uint32_t send_counter = 0U;
	static const uint8_t telem_ids[18] = {
		PROTO_FLOAT_ID_MOTOR1_ANGLE,   /* [0] PID input (trajectory setpoint) */
		PROTO_FLOAT_ID_MOTOR1_SPEED,   /* [1] feedback (roll) */
		PROTO_FLOAT_ID_MOTOR1_CURRENT, /* [2] PID output */
		PROTO_FLOAT_ID_MOTOR1_KP,      /* [3] Kp */
		PROTO_FLOAT_ID_MOTOR1_KI,      /* [4] Ki */
		PROTO_FLOAT_ID_MOTOR2_ANGLE,   /* [5] planned position (°) */
		PROTO_FLOAT_ID_MOTOR2_SPEED,   /* [6] actual position (°) */
		PROTO_FLOAT_ID_MOTOR2_TORQUE,  /* [7] planned velocity (°/s) */
		PROTO_FLOAT_ID_MOTOR2_KP,      /* [8] actual velocity (°/s) */
		PROTO_FLOAT_ID_MOTOR2_KD,      /* [9] torque (N*m) */
		PROTO_FLOAT_ID_FORCE_FX,       /* [10] DR304 Fx (N) */
		PROTO_FLOAT_ID_FORCE_FY,       /* [11] DR304 Fy (N) */
		PROTO_FLOAT_ID_FORCE_FZ,       /* [12] DR304 Fz (N) */
		PROTO_FLOAT_ID_FORCE_MX,       /* [13] DR304 Mx (N*m) */
		PROTO_FLOAT_ID_FORCE_MY,       /* [14] DR304 My (N*m) */
		PROTO_FLOAT_ID_FORCE_MZ,       /* [15] DR304 Mz (N*m) */
		PROTO_FLOAT_ID_M1_ACTV_SPEED,  /* [16] M1 T-wave (°) */
		PROTO_FLOAT_ID_M2_ACTV_SPEED,  /* [17] M2 T-wave (°) */
	};
	float telem_vals[18];
	float ft_vals[6];

	/* Throttle to ~20Hz (every 5 control cycles) */
	send_counter++;
	if (send_counter < 5U) return;
	send_counter = 0U;

	/* Motor1 data */
	telem_vals[0] = Control_P_PID.In_val;        /* PID setpoint (trajectory) */
	telem_vals[1] = roll;                         /* PID feedback (IMU roll) */
	telem_vals[2] = Control_P_PID.u_out;          /* PID output */
	telem_vals[3] = my_Order_mode.motor1_kp;      /* Kp */
	telem_vals[4] = my_Order_mode.motor1_ki;      /* Ki */

	/* Motor2: planned=target, actual=CAN feedback */
	telem_vals[5] = g_m2_traj_deg;                         /* planned position (°) */
	telem_vals[6] = motor_feedback.position * 57.29578f;   /* actual position (rad→°) */
	telem_vals[7] = g_m2_traj_vel * 100.0f;                /* planned velocity (deg/cycle→°/s) */
	telem_vals[8] = motor_feedback.speed * 57.29578f;      /* actual velocity (rad/s→°/s) */
	telem_vals[9] = motor_feedback.torque;                 /* torque (N·m) */

	/* Force sensor: DR304 via UART2 Modbus */
	USART2_DR304GetLatestValues(ft_vals);
	telem_vals[10] = ft_vals[0];
	telem_vals[11] = ft_vals[1];
	telem_vals[12] = ft_vals[2];
	telem_vals[13] = ft_vals[3];
	telem_vals[14] = ft_vals[4];
	telem_vals[15] = ft_vals[5];

	/* T-wave virtual trajectory */
	telem_vals[16] = g_actv_traj_pos;
	telem_vals[17] = g_actv_traj_pos_m2;

	(void)proto_app_send_telemetry(18U, telem_ids, telem_vals);
}
void Motor1_dingdian_control_process(void);

