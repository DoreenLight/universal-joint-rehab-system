  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_SoftI2C_Init();
  MX_TIM9_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  MX_CAN1_Init();
  MX_TIM2_Init();
  MX_USART3_UART_Init();
  MX_TIM6_Init();
  /* USER CODE BEGIN 2 */

	Controller_Init();
      // 鍒濆鍖栧欢鏃跺嚱鏁?
    delay_init();
	    proto_transport_init();
	    proto_app_init();
	    proto_app_set_float_callback(app_float_callback);
	    proto_app_set_io_callback(app_io_callback);
	    flash_store_load();

    uint8_t soft_i2c_scl_high = 0U;
    uint8_t soft_i2c_sda_high = 0U;
    HAL_StatusTypeDef mpu_init_status;
    SoftI2C_GetBusState(&soft_i2c_scl_high, &soft_i2c_sda_high);
    printf("Boot: IMU init start (SCL=%u SDA=%u)\r\n",
           (unsigned int)soft_i2c_scl_high, (unsigned int)soft_i2c_sda_high);
    mpu_init_status = MPU6050_Init();
    if (mpu_init_status == HAL_OK)
    {
        printf("Boot: IMU who_am_i=0x%02X\r\n",
               (unsigned int)MPU6050_GetWhoAmI());
    }
    else
    {
        printf("Boot: IMU init error=%d\r\n",
               (int)MPU6050_GetInitError());
    }
    if ((mpu_init_status == HAL_OK) &&
        (MPU6050_Calibrate(400U) == HAL_OK))
    {
        g_mpu6050_ready = 1U;
        printf("Boot: IMU ready\r\n");
    }
    else
    {
        printf("Boot: IMU init failed (err=%d)\r\n",
               (int)MPU6050_GetInitError());
    }
	
	AD7606_Init();
  
    printf("Boot: system ready\r\n");
  
  	HAL_TIM_PWM_Start(&htim9,TIM_CHANNEL_1);
	HAL_TIM_PWM_Start(&htim9,TIM_CHANNEL_2);
  
	__HAL_TIM_SetCompare(&htim9, TIM_CHANNEL_1, (uint32_t)(1049.0f * 0.0f));
	__HAL_TIM_SetCompare(&htim9, TIM_CHANNEL_2, (uint32_t)(1049.0f * 0.0f));

	
	HAL_CAN_Start(&hcan1);                   // 鍚姩 CAN
	HAL_Delay(100);
	RS00_WriteParamUint8(0x7F, 0xFD, 0x7005, 0);
	
	// 绛夊緟绯荤粺绋冲畾锛堝彲閫夛級
	HAL_Delay(2000);

	// 1. 浣胯兘鐢垫満锛堢數鏈篒D=0x7F锛屼富鏈篒D=0xFD锛?
	RS00_Enable(0x7F, 0xFD);
	HAL_Delay(500);  // 绛夊緟浣胯兘瀹屾垚
	HAL_Delay(500);
	RS00_StartHoming(0x7F,0xFD);
	
	uint32_t last_time = HAL_GetTick();
	uint32_t mpu_sample_time = HAL_GetTick();
	uint32_t mpu_print_time = HAL_GetTick();
	
	 // 涓婄數鍏堝畬鎴愬洖闆?
    //void Home_Motor_Safe(void);

//    //鍥為浂缁撴潫锛岀幇鍦?g_total_angle_1 宸茬粡鏄?0
//    // 璁剧疆瀹氱偣鎺у埗
//    my_Order_mode.start_or_stop = _start;
//    my_Order_mode.mode = dingdian;
//    my_Order_mode.motor1_jiaodu = 0.0f;   // 姝ゆ椂灏辨槸鍦ㄩ浂鐐?
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  if (g_mpu6050_ready != 0U)
	  {
		  uint32_t now = HAL_GetTick();
		  MPU6050_Process();
		  if ((uint32_t)(now - mpu_sample_time) >= 5U)
		  {
			  mpu_sample_time = now;
			  (void)MPU6050_RequestUpdate();
		  }
		  if ((uint32_t)(now - mpu_print_time) >= 500U)
		  {
			  mpu_print_time = now;
			  /* MPU6050_PrintUSART1(); */
		  }
	  }
	 
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	
	 
	
	   /*can ceshi */

//		Command_Process();
		control_process();
