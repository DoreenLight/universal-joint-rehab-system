/* --- UART3 float dispatch → motor_ctrl --- */
static void app_float_callback(uint8_t float_id, float value)
{
    switch (float_id)
    {
    case PROTO_FLOAT_ID_MOTOR1_ANGLE:        motor1_set_angle(value);        break;
    case PROTO_FLOAT_ID_MOTOR1_SPEED:        motor1_set_speed(value);        break;
    case PROTO_FLOAT_ID_MOTOR1_CURRENT:      motor1_set_current(value);      break;
    case PROTO_FLOAT_ID_MOTOR1_KP:           motor1_set_kp(value);           break;
    case PROTO_FLOAT_ID_MOTOR1_KI:           motor1_set_ki(value);           break;
    case PROTO_FLOAT_ID_MOTOR1_PWM:          motor1_set_pwm_duty(value);      break;
    case PROTO_FLOAT_ID_MOTOR1_MAX_SPEED:    motor1_set_max_speed(value);     break;
    case PROTO_FLOAT_ID_MOTOR1_REHAB_MIN:   motor1_set_rehab_min(value);     break;
    case PROTO_FLOAT_ID_MOTOR1_REHAB_MAX:   motor1_set_rehab_max(value);     break;
    case PROTO_FLOAT_ID_MOTOR1_REHAB_CYCLES:motor1_set_rehab_cycles(value);  break;
    case PROTO_FLOAT_ID_M1_ACTV_SPEED:       motor1_set_actv_speed(value);    break;
    case PROTO_FLOAT_ID_M1_ACTV_LIMIT1:      motor1_set_actv_limit1(value);   break;
    case PROTO_FLOAT_ID_M1_ACTV_LIMIT2:      motor1_set_actv_limit2(value);   break;
    case PROTO_FLOAT_ID_M1_ACTV_PAUSE:       motor1_set_actv_pause(value);    break;
    case PROTO_FLOAT_ID_M1_ACTV_TMAX:        motor1_set_actv_tmax(value);     break;
    case PROTO_FLOAT_ID_M1_ACTV_STIFF:       motor1_set_actv_stiffness(value);break;
    case PROTO_FLOAT_ID_MOTOR2_ANGLE:        motor2_set_position(value);      break;
    case PROTO_FLOAT_ID_MOTOR2_SPEED:        motor2_set_velocity(value);     break;
    case PROTO_FLOAT_ID_MOTOR2_TORQUE:       motor2_set_torque(value);       break;
    case PROTO_FLOAT_ID_MOTOR2_KP:           motor2_set_kp(value);           break;
    case PROTO_FLOAT_ID_MOTOR2_KD:           motor2_set_kd(value);           break;
    case PROTO_FLOAT_ID_MOTOR2_MAX_SPEED:    motor2_set_max_speed(value);     break;
    case PROTO_FLOAT_ID_MOTOR2_CURRENT_LIMIT:motor2_set_current_limit(value);break;
    case PROTO_FLOAT_ID_MOTOR2_REHAB_MIN:   motor2_set_rehab_min(value);     break;
    case PROTO_FLOAT_ID_MOTOR2_REHAB_MAX:   motor2_set_rehab_max(value);     break;
    case PROTO_FLOAT_ID_MOTOR2_REHAB_CYCLES:motor2_set_rehab_cycles(value);  break;
    case PROTO_FLOAT_ID_M2_ACTV_SPEED:   motor2_set_actv_speed(value);       break;
    case PROTO_FLOAT_ID_M2_ACTV_LIMIT1:  motor2_set_actv_limit1(value);      break;
    case PROTO_FLOAT_ID_M2_ACTV_LIMIT2:  motor2_set_actv_limit2(value);      break;
    case PROTO_FLOAT_ID_M2_ACTV_PAUSE:   motor2_set_actv_pause(value);       break;
    case PROTO_FLOAT_ID_M2_ACTV_FMAX:    motor2_set_actv_fmax(value);        break;
    case PROTO_FLOAT_ID_M2_ACTV_STIFF:   motor2_set_actv_stiffness(value);   break;
    default: break;
    }
}

/* --- UART3 IO dispatch → motor_ctrl --- */
static void app_io_callback(uint8_t io_id, uint8_t state)
{
    switch (io_id)
    {
    case PROTO_IO_ID_M1_START_STOP:
        if (state == 1u) motor1_start();
        else             motor1_stop();
        break;
    case PROTO_IO_ID_MODE:
        motor1_ctrl_set_mode(state);
        break;
    case PROTO_IO_ID_M2_START_STOP:
        if (state == 1u) motor2_enable();
        else             motor2_stop();
        break;
    case PROTO_IO_ID_M2_RUN_MODE:
        motor2_set_mode(state);
        break;
    case PROTO_IO_ID_M2_SET_ZERO:
        motor2_set_zero();
        break;
    case PROTO_IO_ID_M2_CLEAR_ERR:
        motor2_clear_error();
        break;
    case PROTO_IO_ID_M2_TRAJ_MODE:
        g_m2_traj_mode = state;
        break;
    case PROTO_IO_ID_M1_REHAB:
        if (state == 1u) {
            g_rehab_m1.active = 1u;
            g_rehab_m1.state  = REHAB_FORWARD;
            g_rehab_m1.target = motor1_get_rehab_max();
            g_rehab_m1.half_cycles = 0u;
            motor1_ctrl_set_mode(0u);  /* force position mode */
            motor1_start();
            printf("Rehab M1: start, %.1f<->%.1f x%u\r\n",
                   (double)motor1_get_rehab_min(),
                   (double)motor1_get_rehab_max(),
                   (unsigned int)motor1_get_rehab_cycles());
        } else {
            g_rehab_m1.active = 0u;
            g_rehab_m1.state  = REHAB_IDLE;
            /* Stop TIM2 only if M2 rehab also idle */
            if (!g_rehab_m2.active) {
                motor1_stop();
            }
            printf("Rehab M1: stopped\r\n");
        }
        break;
    case PROTO_IO_ID_M2_REHAB:
        if (state == 1u) {
            g_rehab_m2.active = 1u;
            g_rehab_m2.state  = REHAB_FORWARD;
            g_rehab_m2.target = motor2_get_rehab_max();
            g_rehab_m2.half_cycles = 0u;
            g_m2_traj_mode = 0u;   /* force position mode */
            motor2_enable();
            /* Kick off control loop (normally started by motor1_start) */
            if (my_Order_mode.start_or_stop != _start) {
                my_Order_mode.start_or_stop = _start;
                TIM2_Start_IT();
            }
            printf("Rehab M2: start, %.1f<->%.1f x%u\r\n",
                   (double)motor2_get_rehab_min(),
                   (double)motor2_get_rehab_max(),
                   (unsigned int)motor2_get_rehab_cycles());
        } else {
            g_rehab_m2.active = 0u;
            g_rehab_m2.state  = REHAB_IDLE;
            motor2_stop();
            /* Stop control loop only if M1 rehab is also idle */
            if (!g_rehab_m1.active) {
                my_Order_mode.start_or_stop = _stop;
                TIM2_Stop_IT();
            }
            printf("Rehab M2: stopped\r\n");
        }
        break;
    case PROTO_IO_ID_SYS_RUN:
        if (state == 1u) {
            my_Order_mode.start_or_stop = _start;
            TIM2_Start_IT();
            printf("SYS: control loop started\r\n");
        } else {
            my_Order_mode.start_or_stop = _stop;
            TIM2_Stop_IT();
            printf("SYS: control loop stopped\r\n");
        }
        break;
    case PROTO_IO_ID_M1_ACTV_REHAB:
        if (state == 1u) {
            g_actv_m1.active = 1u;
            g_actv_m1.state  = ACTV_PAUSE_1;
            g_actv_m1.pos    = motor1_get_actv_limit1();
            g_actv_m1.vel    = 0.0f;
            g_actv_m1.pause_ticks = (uint16_t)(motor1_get_actv_pause() * 100.0f);
            g_actv_traj_pos  = motor1_get_actv_limit1();
            /* Kick off control loop if not running */
            if (my_Order_mode.start_or_stop != _start) {
                my_Order_mode.start_or_stop = _start;
                TIM2_Start_IT();
            }
            motor1_ctrl_set_mode(1u);  /* velocity mode for force compliance */
            motor1_start();
            printf("ActiveRehab M1: start, %.1f<->%.1f spd=%.1f tmax=%.1f k=%.1f\r\n",
                   (double)motor1_get_actv_limit1(),
                   (double)motor1_get_actv_limit2(),
                   (double)motor1_get_actv_speed(),
                   (double)motor1_get_actv_tmax(),
                   (double)motor1_get_actv_stiffness());
        } else {
            g_actv_m1.active = 0u;
            if (!g_rehab_m1.active && !g_rehab_m2.active) {
                motor1_stop();
            }
            printf("ActiveRehab M1: stopped\r\n");
        }
        break;
    case PROTO_IO_ID_M2_ACTV_REHAB:
        if (state == 1u) {
            /* Position Motor1 first based on mode */
            motor1_ctrl_set_mode(0u);  /* position mode */
            if (g_actv_m2_mode == 1u) {
                motor1_set_angle(0.0f);
            } else {
                motor1_set_angle(80.0f);
            }
            g_actv_m2.active = 1u;
            g_actv_m2.state  = ACTV_PAUSE_1;
            g_actv_m2.pos    = motor2_get_actv_limit1();
            g_actv_m2.vel    = 0.0f;
            g_actv_m2.pause_ticks = (uint16_t)(motor2_get_actv_pause() * 100.0f);
            g_actv_traj_pos_m2 = motor2_get_actv_limit1();
            if (my_Order_mode.start_or_stop != _start) {
                my_Order_mode.start_or_stop = _start;
                TIM2_Start_IT();
            }
            motor1_start();
            motor2_enable();
            printf("ActiveRehab M2: mode=%u start, %.1f<->%.1f fmax=%.1f k=%.1f\r\n",
                   (unsigned int)g_actv_m2_mode,
                   (double)motor2_get_actv_limit1(),
                   (double)motor2_get_actv_limit2(),
                   (double)motor2_get_actv_fmax(),
                   (double)motor2_get_actv_stiffness());
        } else {
            g_actv_m2.active = 0u;
            motor2_stop();
            if (!g_rehab_m1.active && !g_rehab_m2.active && !g_actv_m1.active) {
                motor1_stop();
            }
            printf("ActiveRehab M2: stopped\r\n");
        }
        break;
    case PROTO_IO_ID_M2_ACTV_MODE:
        g_actv_m2_mode = (state == 2u) ? 2u : 1u;
        printf("ActiveRehab M2: mode=%u\r\n", (unsigned int)g_actv_m2_mode);
        break;
    case PROTO_IO_ID_FORCE_ZERO:
        USART2_DR304SetZero();
        break;
    default: break;
    }
}

