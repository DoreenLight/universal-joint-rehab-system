/* USER CODE BEGIN 4 */


void set_motor_pwm(float pwm1,float pwm2)
{
	
	float real_pwm1, real_pwm2;
	real_pwm1 = limit(pwm1,1.0f,0.0f);
	real_pwm2 = limit(pwm2,1.0f,0.0f);
	
	//printf("real1 = %f,real2 =%f\n",real_pwm1,real_pwm2);
	
	__HAL_TIM_SetCompare(&htim9, TIM_CHANNEL_1, (uint32_t)(Motor_count * real_pwm1));
	__HAL_TIM_SetCompare(&htim9, TIM_CHANNEL_2, (uint32_t)(Motor_count * real_pwm2)); 
}

void control_process(void)
{
	if (my_Order_mode.start_or_stop == _start)
	{
		if (My_state == work_flag)
		{
			switch (controller_flag)		//閿熸枻鎷烽敓鏂ゆ嫹閿熼樁鍒侯剨鎷烽敓鏂ゆ嫹閿熸彮鎭㈡唻鎷烽敓绐栴叏鎷烽敓鏂ゆ嫹妯￠敓鏂ゆ嫹閿熸枻鎷烽敓鏂ゆ嫹閿熸彮浼欐嫹閿熸枻鎷穡ork_flag,閿熸枻鎷?0ms閿熸枻鎷烽敓鏂ゆ嫹閿熼摪闈╂嫹浣嶄竴閿熻娇鐨勨槄鎷?
			{
				case wait:
					controller_flag = caiji;
				break;
				case caiji:
					AD_Caiyang_process();		//閿熸枻鎷烽敓鏂ゆ嫹閿熸嵎闈╂嫹閿熼摪纰夋嫹h_as5600閿熸枻鎷烽敓鏂ゆ嫹宄佺櫢鎷烽敓鏂ゆ嫹閿熸枻鎷烽敓鏂ゆ嫹閿?
					controller_flag = creat_order;
				break;
				case creat_order:
					Order_Creat_process();
					controller_flag = controller_cal;
				break;
			case controller_cal:
				/* Mode dispatch: PID or PWM */
				if (my_Order_mode.mode == PWM_test)
				{
					float temp_pwm = motor1_get_pwm_duty();
					float temp = 0.0001f;
					if (temp_pwm > temp)
					{
						zhan_1_temp = temp_pwm;
						zhan_2_temp = 0.0f;
					}
					else if (fabs(temp_pwm) <= temp)
					{
						zhan_1_temp = 0.0f;
						zhan_2_temp = 0.0f;
					}
					else
					{
						zhan_1_temp = 0.0f;
						zhan_2_temp = -temp_pwm;
					}
				}
				else
				{
					Motor1_dingdian_control_process();
				}
				set_motor_pwm(zhan_1_temp, zhan_2_temp);
				controller_flag = fresh_data;
			break;
				case fresh_data:
					//printf("5\n");
					Signal_UPdata_Process();
					My_state = stop_flag;						//閿熼ズ杈炬嫹閿熸枻鎷锋椂閿熷彨鏂綇鎷烽敓鏂ゆ嫹閿熸枻鎷烽敓鏂ゆ嫹涓洪敓鏂ゆ嫹閿熸枻鎷风姸鎬?
					controller_flag = wait;					
				break;
				default:
					//printf("6\n");
					controller_flag = wait;
					break;
				}
		}
	}
	else
	{
		set_motor_pwm(0.0f, 0.0f);
	}
	
}



void AD_Caiyang_process(void)
{
	static float g_prev_angle_littlt = 0.0f;
//璇诲彇鐢垫祦鍊煎拰缂栫爜鍣ㄥ弬鏁帮紝鍚屾椂鏇存柊缂栫爜鍣?
	int16_t sensor_value[8] = {0};
	Get_7606_Average(sensor_value);

	//鐪熸槸鐢靛帇鍊?U * 10 / 22, 鐢靛帇鑼冨洿鏄?V锛孉D7606鐢靛帇 * 2.2f = 鐪熷疄鐨勭數鍘嬪€?
	Sensor_jiaodu_1.Value_AD = 2.2f * limit(10.0f * sensor_value[5] / 0xFFFF, 5.0 , 0.0);//10.0 * (sensor_value[0] - 0x00) / (0x73BC - 0);
	Sensor_Data_convert(P_Sensor_jiaodu_1);
	
	// 璁＄畻绱瑙掑害
	float current_angle = Sensor_jiaodu_1.Value; // 褰撳墠缁濆瑙掑害鍊?0-360)
	static int32_t revolution = 0; // 鏃嬭浆鍦堟暟
	
	
	float delta = current_angle - g_prev_angle_littlt;
	g_prev_angle_littlt = current_angle;
	if(delta > 180.0f)
	{
		revolution--;
	}
	else if(delta < -180.0f)
	{
		revolution++;
	}
	
	g_total_angle_1 = (float)revolution * 360.0f + current_angle;
	
	g_prev_angle_1 = current_angle;
	
	Sensor_I1.Value_AD = limit(10.0f * sensor_value[4] / 0xFFFF, 5.0 , 0.0);
	Sensor_I1.Value = Sensor_I1.Value_AD * 1000.0f / 20 * 1000.0f;	//1A瀵瑰簲鐨勭數鍘嬪€兼槸20mV锛岃繖閲岃€冮獙鐢垫祦妫€娴嬭兘鍔涚殑澶у皬锛屾渶鍚庣殑鍒版槸mA
}

/* --- Rehab state advance (called when trajectory reaches target) --- */
static void rehab_advance(rehab_ctx_t *ctx, uint8_t is_motor2)
{
    uint16_t total;

    switch (ctx->state)
    {
    case REHAB_IDLE:
        break;
    case REHAB_FORWARD:
        ctx->state = REHAB_BACKWARD;
        if (is_motor2) {
            ctx->target = motor2_get_rehab_min();
            total = motor2_get_rehab_cycles();
        } else {
            ctx->target = motor1_get_rehab_min();
            total = motor1_get_rehab_cycles();
        }
        ctx->half_cycles++;
        break;
    case REHAB_BACKWARD:
        ctx->half_cycles++;
        if (is_motor2) total = motor2_get_rehab_cycles();
        else            total = motor1_get_rehab_cycles();
        if (ctx->half_cycles >= total * 2u) {
            ctx->state  = REHAB_RETURN;
            ctx->target = 0.0f;
        } else {
            ctx->state = REHAB_FORWARD;
            if (is_motor2) ctx->target = motor2_get_rehab_max();
            else           ctx->target = motor1_get_rehab_max();
        }
        break;
    case REHAB_RETURN:
        ctx->active = 0u;
        ctx->state  = REHAB_IDLE;
        if (is_motor2) {
            motor2_stop();
            if (!g_rehab_m1.active) {
                my_Order_mode.start_or_stop = _stop;
                TIM2_Stop_IT();
            }
        } else {
            if (!g_rehab_m2.active) motor1_stop();
        }
        printf("Rehab %s: done\r\n", is_motor2 ? "M2" : "M1");
        break;
    }
}

/* --- T-wave virtual trajectory tick (100Hz) --- */
static void actv_twave_tick(actv_rehab_t *ctx)
{
	float limit1 = motor1_get_actv_limit1();
	float limit2 = motor1_get_actv_limit2();
	float speed  = motor1_get_actv_speed() * 0.01f;  /* deg/s -> deg/cycle */
	float accel  = 0.1f;  /* deg/cycle^2, same as passive rehab */

	switch (ctx->state)
	{
	case ACTV_PAUSE_1:
		if (ctx->pause_ticks > 0u) { ctx->pause_ticks--; return; }
		ctx->state = ACTV_MOVING_TO_2;
		ctx->vel   = 0.0f;
		break;

	case ACTV_MOVING_TO_2:
		{
			float error = limit2 - ctx->pos;
			if (fabsf(error) < 0.01f) {
				ctx->pos = limit2;
				ctx->vel = 0.0f;
				ctx->state = ACTV_PAUSE_2;
				ctx->pause_ticks = (uint16_t)(motor1_get_actv_pause() * 100.0f);
			} else {
				float dir   = (error > 0.0f) ? 1.0f : -1.0f;
				float dist  = fabsf(error);
				float v_max = speed;
				float v_decel = sqrtf(2.0f * accel * dist);
				if (v_decel < v_max) v_max = v_decel;
				if (v_max < 0.01f)   v_max = 0.01f;
				ctx->vel += accel * dir;
				if (ctx->vel >  v_max) ctx->vel =  v_max;
				if (ctx->vel < -v_max) ctx->vel = -v_max;
				ctx->pos += ctx->vel;
				if (fabsf(ctx->pos - limit2) < 0.005f) ctx->pos = limit2;
			}
		}
		break;

	case ACTV_PAUSE_2:
		if (ctx->pause_ticks > 0u) { ctx->pause_ticks--; return; }
		ctx->state = ACTV_MOVING_TO_1;
		ctx->vel   = 0.0f;
		break;

	case ACTV_MOVING_TO_1:
		{
			float error = limit1 - ctx->pos;
			if (fabsf(error) < 0.01f) {
				ctx->pos = limit1;
				ctx->vel = 0.0f;
				ctx->state = ACTV_PAUSE_1;
				ctx->pause_ticks = (uint16_t)(motor1_get_actv_pause() * 100.0f);
			} else {
				float dir   = (error > 0.0f) ? 1.0f : -1.0f;
				float dist  = fabsf(error);
				float v_max = speed;
				float v_decel = sqrtf(2.0f * accel * dist);
				if (v_decel < v_max) v_max = v_decel;
				if (v_max < 0.01f)   v_max = 0.01f;
				ctx->vel += accel * dir;
				if (ctx->vel >  v_max) ctx->vel =  v_max;
				if (ctx->vel < -v_max) ctx->vel = -v_max;
				ctx->pos += ctx->vel;
				if (fabsf(ctx->pos - limit1) < 0.005f) ctx->pos = limit1;
			}
		}
		break;
	}
}

/* --- M2 T-wave virtual trajectory tick (100Hz) --- */
static void actv_twave_tick_m2(actv_rehab_t *ctx)
{
	float limit1 = motor2_get_actv_limit1();
	float limit2 = motor2_get_actv_limit2();
	float speed  = motor2_get_actv_speed() * 0.01f;
	float accel  = 0.1f;

	switch (ctx->state)
	{
	case ACTV_PAUSE_1:
		if (ctx->pause_ticks > 0u) { ctx->pause_ticks--; return; }
		ctx->state = ACTV_MOVING_TO_2;
		ctx->vel   = 0.0f;
		break;
	case ACTV_MOVING_TO_2:
		{
			float error = limit2 - ctx->pos;
			if (fabsf(error) < 0.01f) {
				ctx->pos = limit2; ctx->vel = 0.0f;
				ctx->state = ACTV_PAUSE_2;
				ctx->pause_ticks = (uint16_t)(motor2_get_actv_pause() * 100.0f);
			} else {
				float dir = (error > 0.0f) ? 1.0f : -1.0f;
				float v_max = (speed < sqrtf(2.0f*accel*fabsf(error))) ? speed : sqrtf(2.0f*accel*fabsf(error));
				if (v_max < 0.01f) v_max = 0.01f;
				ctx->vel += accel * dir;
				if (ctx->vel > v_max) ctx->vel = v_max;
				if (ctx->vel < -v_max) ctx->vel = -v_max;
				ctx->pos += ctx->vel;
				if (fabsf(ctx->pos - limit2) < 0.005f) ctx->pos = limit2;
			}
		}
		break;
	case ACTV_PAUSE_2:
		if (ctx->pause_ticks > 0u) { ctx->pause_ticks--; return; }
		ctx->state = ACTV_MOVING_TO_1;
		ctx->vel   = 0.0f;
		break;
	case ACTV_MOVING_TO_1:
		{
			float error = limit1 - ctx->pos;
			if (fabsf(error) < 0.01f) {
				ctx->pos = limit1; ctx->vel = 0.0f;
				ctx->state = ACTV_PAUSE_1;
				ctx->pause_ticks = (uint16_t)(motor2_get_actv_pause() * 100.0f);
			} else {
				float dir = (error > 0.0f) ? 1.0f : -1.0f;
				float v_max = (speed < sqrtf(2.0f*accel*fabsf(error))) ? speed : sqrtf(2.0f*accel*fabsf(error));
				if (v_max < 0.01f) v_max = 0.01f;
				ctx->vel += accel * dir;
				if (ctx->vel > v_max) ctx->vel = v_max;
				if (ctx->vel < -v_max) ctx->vel = -v_max;
				ctx->pos += ctx->vel;
				if (fabsf(ctx->pos - limit1) < 0.005f) ctx->pos = limit1;
			}
		}
		break;
	}
}

void Order_Creat_process(void)
{
	/* ==================== Motor1 Trajectory ==================== */
	{
		static float    m1_traj_current  = 0.0f;
		static float    m1_traj_velocity = 0.0f;
		float m1_max_speed = motor1_get_max_speed();
		float m1_max_accel = 0.1f;

		/* Active rehab: T-wave virtual trajectory + force compliance */
		if (g_actv_m1.active)
		{
			float ft_vals[6];
			float mx, tmax, k;

			/* 1. Advance T-wave virtual trajectory */
			actv_twave_tick(&g_actv_m1);
			g_actv_traj_pos = g_actv_m1.pos;

			/* 2. Force compliance: check Mx torque, set motor velocity */
			USART2_DR304GetLatestValues(ft_vals);
			mx    = ft_vals[3];                 /* Mx (N*m) */
			tmax  = motor1_get_actv_tmax();
			k     = motor1_get_actv_stiffness();

			if (fabsf(mx) > tmax)
			{
				float excess = fabsf(mx) - tmax;
				float dir   = (mx > 0.0f) ? -1.0f : 1.0f;  /* -sign(Mx): torque & vel opposite */
				my_Order_mode.motor1_sudu = dir * excess / k;
			}
			else
			{
				my_Order_mode.motor1_sudu = 0.0f;
			}

			/* Velocity mode integration & skip PID */
			m1_traj_current += my_Order_mode.motor1_sudu * 0.01f;
			Control_P_PID.In_val = m1_traj_current;
		}
		else
		{

		/* Rehab override: replace target angle with rehab state machine target */
		if (g_rehab_m1.active)
		{
			my_Order_mode.motor1_jiaodu = g_rehab_m1.target;
		}

		if (my_Order_mode.mode != 1u)  /* 0=position, 1=velocity, 3=PWM handled in controller_cal */
		{
			/* Position mode: ramp toward target */
			float target = my_Order_mode.motor1_jiaodu;
			float error  = target - m1_traj_current;
			if (fabsf(error) < 0.01f) { m1_traj_current = target; m1_traj_velocity = 0.0f; }
			else
			{
				float dir   = (error > 0.0f) ? 1.0f : -1.0f;
				float dist  = fabsf(error);
				float v_max = m1_max_speed;
				float v_decel = sqrtf(2.0f * m1_max_accel * dist);
				if (v_decel < v_max) v_max = v_decel;
				if (v_max < 0.01f)   v_max = 0.01f;
				m1_traj_velocity += m1_max_accel * dir;
				if (m1_traj_velocity >  v_max) m1_traj_velocity =  v_max;
				if (m1_traj_velocity < -v_max) m1_traj_velocity = -v_max;
				m1_traj_current += m1_traj_velocity;
				if (fabsf(m1_traj_current - target) < 0.005f) m1_traj_current = target;
			}
		}
		else
		{
			/* Velocity mode: continuously add target velocity */
			m1_traj_current += my_Order_mode.motor1_sudu * 0.01f;
		}

		/* Rehab: check if we've reached the target */
		if (g_rehab_m1.active && fabsf(m1_traj_current - g_rehab_m1.target) < 0.05f)
		{
			rehab_advance(&g_rehab_m1, 0u);
		}

		Control_P_PID.In_val = m1_traj_current;
	}
	}

	/* ==================== Motor2 Trajectory ==================== */
	{
		/* M2 Active rehab: T-wave + force compliance */
		if (g_actv_m2.active)
		{
			float ft_vals[6];
			float ff, fmax, k;

			actv_twave_tick_m2(&g_actv_m2);
			g_actv_traj_pos_m2 = g_actv_m2.pos;

			USART2_DR304GetLatestValues(ft_vals);
			fmax = motor2_get_actv_fmax();
			k    = motor2_get_actv_stiffness();

			/* Select force channel by mode */
			ff = (g_actv_m2_mode == 2u) ? ft_vals[4] : ft_vals[1];  /* Ty(My) or Fy */

			if (fabsf(ff) > fmax)
			{
				float excess = fabsf(ff) - fmax;
				float dir;
				if (g_actv_m2_mode == 2u) {
					dir = (ff > 0.0f) ? 1.0f : -1.0f;   /* mode2: no sign flip */
				} else {
					dir = (ff > 0.0f) ? -1.0f : 1.0f;   /* mode1: flip sign */
				}
				motor2_set_velocity(dir * excess / k);  /* deg/s */
			}
			else
			{
				motor2_set_velocity(0.0f);
			}

			/* Force compliance: move from current position, or hold if |F|<Fmax */
			{
				static float m2_cmd_pos_rad = 0.0f;
				static uint8_t m2_cmd_pos_inited = 0u;
				float vel_rad = motor2_get_velocity() * 0.0174532925f;  /* deg/s -> rad/s */

				if (!m2_cmd_pos_inited) {
					m2_cmd_pos_rad = motor_feedback.position;
					m2_cmd_pos_inited = 1u;
				}

				if (fabsf(vel_rad) < 0.0001f) {
					/* Below threshold: hold current position */
					m2_cmd_pos_rad = motor_feedback.position;
				} else {
					/* Above threshold: integrate velocity */
					m2_cmd_pos_rad += vel_rad * 0.01f;  /* rad/cycle */
				}

				motor2_send_control(m2_cmd_pos_rad,
				                    vel_rad,
				                    motor2_get_torque(),
				                    motor2_get_kp(),
				                    motor2_get_kd());
			}
		}
		else
		{

		/* Rehab override */
		if (g_rehab_m2.active)
		{
			motor2_set_position(g_rehab_m2.target);
		}

		float m2_target    = motor2_get_position();   /* deg */
		float m2_max_spd   = motor2_get_max_speed();  /* deg/cycle */
		float m2_max_accel = 0.1f;

		if (g_m2_traj_mode == 0u)
		{
			/* Position mode: ramp toward target */
			float error = m2_target - g_m2_traj_deg;
			if (fabsf(error) < 0.01f) { g_m2_traj_deg = m2_target; g_m2_traj_vel = 0.0f; }
			else
			{
				float dir   = (error > 0.0f) ? 1.0f : -1.0f;
				float dist  = fabsf(error);
				float v_max = m2_max_spd;
				float v_decel = sqrtf(2.0f * m2_max_accel * dist);
				if (v_decel < v_max) v_max = v_decel;
				if (v_max < 0.01f)   v_max = 0.01f;
				g_m2_traj_vel += m2_max_accel * dir;
				if (g_m2_traj_vel >  v_max) g_m2_traj_vel =  v_max;
				if (g_m2_traj_vel < -v_max) g_m2_traj_vel = -v_max;
				g_m2_traj_deg += g_m2_traj_vel;
				if (fabsf(g_m2_traj_deg - m2_target) < 0.005f) g_m2_traj_deg = m2_target;
			}
		}
		else
		{
			/* Velocity mode: continuously add target velocity */
			g_m2_traj_vel  = motor2_get_velocity() * 0.01f;   /* deg/s -> deg/cycle, stored for telemetry */
			g_m2_traj_deg += g_m2_traj_vel;
		}

		/* Rehab: check arrival */
		if (g_rehab_m2.active && fabsf(g_m2_traj_deg - g_rehab_m2.target) < 0.05f)
		{
			rehab_advance(&g_rehab_m2, 1u);
		}

		/* Send RS00 control: convert degrees -> radians */
		#define M2_DEG_TO_RAD  0.0174532925f  /* PI/180 */
		motor2_send_control(g_m2_traj_deg * M2_DEG_TO_RAD,
		                    0.0f,
		                    motor2_get_torque(),
		                    motor2_get_kp(),
		                    motor2_get_kd());
}
	}
}

void Motor1_dingdian_control_process(void)
{
	float u = 0.0f;
	
	/* In_val set by Order_Creat_process (trajectory planner) */
//	Control_P_PID.Feedback_val = Sensor_jiaodu_1.Value;	//闄や互67.5
	Control_P_PID.Feedback_val = roll;	//°，±90°

		
	//Control_P_PID.kp = Control_P_PID.kp * 0.01f;
	
	PID_controller(P_Control_P_PID);
	
	u = -1.0f * Control_P_PID.u_out;
	
//	printf("u=%f\r\n",u);

	float deadband = 0.04f;
	if (u > deadband)
	{
		zhan_1_temp = u - deadband;
		zhan_2_temp = 0.0f;
	}
	else if (fabsf(u) <= deadband)
	{
		zhan_1_temp = 0.0f;
		zhan_2_temp = 0.0f;						
	}
	else
	{
		zhan_1_temp = 0.0f;
		zhan_2_temp = -u - deadband;
	}			
}



		

int fputc(int c, FILE *stream)
{
    (void)stream;
    HAL_UART_Transmit(&huart1, (unsigned char *)&c, 1, 1000);
    return 1;
}


void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if(GPIO_Pin == GPIO_PIN_3)
    {
        Chilun_arrive_flag = 1;
    }
}
